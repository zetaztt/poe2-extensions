{
	"name": "zeta-poe2-extensions",
	"description": "manifest.json description",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"workspaces": [
		"projects/apps/*",
		"projects/packages/*"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"compile": "npm run lint && vue-tsc --build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint projects scripts vite.config.ts",
		"pull-trade-texts": "tsx ./scripts/translate/pull-trade-texts.ts",
		"pull-translate": "npm run pull-trade-texts",
		"build-translate": "tsx ./scripts/translate/build-translate.ts"
	},
	"devDependencies": {
		"@types/chrome": "^0.2.2",
		"@types/node": "^25.9.2",
		"@types/webextension-polyfill": "^0.12.5",
		"@vitejs/plugin-vue": "^6.0.7",
		"eslint": "^9.39.5",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.16.1",
		"jiti": "^2.6.1",
		"prettier": "^3.8.4",
		"tsx": "^4.22.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.0.16",
		"vite-plugin-web-extension": "^4.5.1",
		"vue-eslint-parser": "^10.4.1",
		"vue-tsc": "^3.2.5",
		"zeta-poe2-trade-translate-tools": "0.0.0"
	}
}
